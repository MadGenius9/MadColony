{
  "$comment": "Big worlds (Phase 1): biome terrains and the continent world generator. The classic 'Temperate valley' is unchanged; the spawn rules below apply only to the continent.",
  "terrain": [
    { "id": "core:deep_water", "name": "Deep water", "color": "#2c5a8c", "passable": false, "buildable": false, "fertility": 0, "drinkable": true, "render": { "style": "water" } },
    { "id": "core:shallows", "name": "River shallows", "color": "#5f93bf", "passable": true, "buildable": false, "fertility": 0, "moveCost": 2.2, "drinkable": true, "render": { "style": "shallows" } },
    { "id": "core:mountain", "name": "Mountain", "color": "#77736c", "passable": false, "buildable": false, "fertility": 0, "render": { "style": "mountain" } },
    { "id": "core:hills", "name": "Hills", "color": "#8a8467", "passable": true, "buildable": true, "fertility": 0.3, "moveCost": 1.5, "render": { "style": "gravel" } },
    { "id": "core:forest_floor", "name": "Forest floor", "color": "#4a7a3c", "passable": true, "buildable": true, "fertility": 0.8, "render": { "style": "grass" } },
    { "id": "core:marsh", "name": "Marsh", "color": "#5c6f45", "passable": true, "buildable": false, "fertility": 0.5, "moveCost": 1.8, "render": { "style": "marsh" } },
    { "id": "core:snow", "name": "Snow", "color": "#e6ebee", "passable": true, "buildable": true, "fertility": 0, "moveCost": 1.3, "render": { "style": "snow" } }
  ],
  "worldgen": [
    {
      "id": "core:continent",
      "name": "Continent",
      "width": 384,
      "height": 288,
      "noiseScale": 40,
      "startClearRadius": 6,
      "startTerrain": "core:grass",
      "layers": [{ "terrain": "core:grass", "below": 2 }],
      "climate": { "yearDays": 30, "summer": 22, "winter": -6, "daySwing": 5 },
      "biomes": {
        "elevationScale": 70,
        "moistureScale": 45,
        "edgeFalloff": 0.45,
        "edgeWidth": 0.16,
        "rivers": { "count": 14, "terrain": "core:shallows", "sourceAbove": 0.86, "spacing": 30, "maxLength": 700 },
        "passTerrain": "core:hills",
        "start": { "terrain": ["core:grass", "core:soil"], "areaRadius": 7 },
        "rules": [
          { "terrain": "core:deep_water", "elevationBelow": 0.2 },
          { "terrain": "core:water", "elevationBelow": 0.3 },
          { "terrain": "core:sand", "elevationBelow": 0.33 },
          { "terrain": "core:snow", "elevationAbove": 0.975 },
          { "terrain": "core:mountain", "elevationAbove": 0.93 },
          { "terrain": "core:hills", "elevationAbove": 0.85 },
          { "terrain": "core:snow", "coldAbove": 0.93 },
          { "terrain": "core:marsh", "moistureAbove": 0.9, "elevationBelow": 0.5 },
          { "terrain": "core:forest_floor", "moistureAbove": 0.62 },
          { "terrain": "core:soil", "moistureAbove": 0.47, "elevationBelow": 0.7 },
          { "terrain": "core:gravel", "moistureBelow": 0.06 },
          { "terrain": "core:grass" }
        ]
      }
    }
  ],
  "spawnRule": [
    { "id": "core:forests", "node": "core:pine", "terrain": ["core:forest_floor"], "density": 0.32, "minDistFromStart": 5, "worldgen": ["core:continent"] },
    { "id": "core:snow_pines", "node": "core:pine", "terrain": ["core:snow"], "density": 0.05, "minDistFromStart": 5, "worldgen": ["core:continent"] },
    { "id": "core:hill_rocks", "node": "core:boulder", "terrain": ["core:hills"], "density": 0.09, "minDistFromStart": 6, "worldgen": ["core:continent"] },
    { "id": "core:forest_berries", "node": "core:berry_bush", "terrain": ["core:forest_floor"], "density": 0.02, "minDistFromStart": 4, "worldgen": ["core:continent"] },
    { "id": "core:marsh_brush", "node": "core:brush", "terrain": ["core:marsh"], "density": 0.12, "minDistFromStart": 3, "worldgen": ["core:continent"] }
  ]
}
